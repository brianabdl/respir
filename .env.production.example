# Copy to .env.production (gitignored, chmod 600) and fill in. Used with:
#   docker compose --env-file .env.production up -d --build
# Generate secrets with: openssl rand -hex 32   (keep them alphanumeric)

APP_NAME="Respir"
# php artisan key:generate --show
APP_KEY=
# Public hostname Caddy serves and gets a Let's Encrypt certificate for (DNS must point here).
APP_DOMAIN=
ACME_EMAIL=
# Image tag; bump per release so you can roll back.
APP_VERSION=latest

DB_DATABASE=agen_gemma
DB_USERNAME=agen_gemma
DB_PASSWORD=

REDIS_PASSWORD=

# Must match on the Laravel and ai-service side (both read this one value).
AI_SERVICE_TOKEN=

# Reverb app credentials. REVERB_APP_KEY is baked into the frontend bundle at build time.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Gemini Live (voice / camera presence only).
GEMINI_API_KEY=

# Mail (verification and password reset). `log` writes to stderr instead of sending.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

# --- ai-service ---
AI_DEVICE=auto
# Gated Hugging Face token; only the `ai-models` setup job uses it.
HF_TOKEN=

# Vertex MedGemma is optional; leave VERTEX_ENDPOINT_ID empty for fake mode.
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_ENDPOINT_ID=
VERTEX_MEDGEMMA_MODEL=medgemma-4b-it
# Service-account key: host path mounted read-only, plus the in-container path to use it.
# Leave both unset on GCP to use workload identity / ADC.
# VERTEX_CREDENTIALS_FILE=./secrets/vertex-sa.json
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/vertex-sa.json
